# temperature control. We need lower P/I values
# to prevent oscillation of the BMI088 temperature
# the ADIS16470 is factory temperature calibrated,
# but the BMI088 isn't, so temperature control is still
# worthwhile
BRD_HEAT_TARG 45
BRD_HEAT_P 50
BRD_HEAT_I 0.07

# turn on the CAN power monitoring(default)
CAN_P1_DRIVER 1
BATT_MONITOR 8

# setup the parameter for the ADC power module
# BATT_VOLT_PIN 16 matches PA0/BATT_VOLTAGE_SENS (ADC1 ch16, same pin as CUAV-X7).
# BATT_CURR_PIN 7 matches PF8/BATT_CURRENT_SENS (ADC3 ch7) -- confirmed against
# build/TARA-X7/hwdef.h's generated analog pin table (ADC3_IN7 -> analog pin 7).
BATT_VOLT_PIN 16
BATT_CURR_PIN 7
BATT_VOLT_MULT 18.000
BATT_AMP_PERVLT 24.000
